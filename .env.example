# Copy this to .env and fill in your values.
# NEVER commit the real .env file — only .env.example goes into git.

# ── Gemini API ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── pgvector (same defaults as the existing project) ─────────────────────────
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5433
PGVECTOR_DB=rag_demo
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=ragpass

# ── Asset ingestion ───────────────────────────────────────────────────────────
# Absolute path to the folder that contains your sprite images
ASSETS_DIR=/path/to/your/sprites
