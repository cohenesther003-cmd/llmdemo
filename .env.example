# Copy this to .env and fill in your values.
# NEVER commit the real .env file — only .env.example goes into git.

# ── Gemini API (free key at aistudio.google.com/app/apikey) ──────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── ChromaDB — no Docker needed, saves to a local folder ─────────────────────
CHROMA_DIR=./chroma_db

# ── Asset ingestion ───────────────────────────────────────────────────────────
# Absolute path to the folder that contains your sprite images
ASSETS_DIR=/path/to/your/sprites
